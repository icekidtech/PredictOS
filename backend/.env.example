# PredictOS — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=8080
ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + TimescaleDB) — URL format
DATABASE_URL=postgres://postgres:postgres@localhost:5432/predictos?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef  # exactly 32 bytes for AES-256

# AI Providers — at least ONE required or server will not start
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Somnia RPC — both networks (user toggles in dashboard)
SOMNIA_TESTNET_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_MAINNET_RPC_URL=https://api.infra.mainnet.somnia.network
DREAMDEX_TESTNET_API_URL=https://stg.api.dreamdex.io/v0
DREAMDEX_MAINNET_API_URL=https://api.dreamdex.io/v0
DREAMDEX_TESTNET_WS_URL=wss://stg.api.dreamdex.io/v0/ws/public
DREAMDEX_MAINNET_WS_URL=wss://api.dreamdex.io/v0/ws/public

# Google OAuth (optional — enables Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3001/api/v1/auth/google/callback
